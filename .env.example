# PostgreSQL connection (local Postgres on Windows/WSL, or `docker compose up -d db`)
DATABASE_URL="postgresql://recurivo:recurivo@localhost:5432/recurivo"
# Public base URL used in emailed links
APP_URL="http://localhost:3000"
# sandbox = store emails in Postgres and show them at /dev/mailbox; smtp = send via SMTP_URL
MAIL_TRANSPORT="sandbox"
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# MAIL_FROM="Recurivo <billing@example.com>"
# Optional: password for seeded demo accounts
# SEED_PASSWORD="Recurivo#2026"

# Worker: how often billing cycles run (ms)
BILLING_INTERVAL_MS=60000
